<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvMovieTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:layout_toLeftOf="@+id/layoutLocation"
                android:text="Lịch chiếu Toy Story 5"
                android:textColor="#111111"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:drawable/dialog_holo_light_frame"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:src="@android:drawable/ic_menu_compass"
                        android:tint="#E91E63" />

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hà Nội"
                        android:textColor="#E91E63"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"
                        android:src="@android:drawable/arrow_down_float"
                        android:tint="#E91E63" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@android:drawable/dialog_holo_light_frame"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:src="@android:drawable/ic_menu_mylocation"
                        android:tint="#333333" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gần bạn"
                        android:textColor="#333333"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnDate17"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:drawable/dialog_holo_light_frame"
                    android:backgroundTint="#E91E63"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvNum17"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="17"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvTxt17"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hôm nay"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDate18"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:drawable/dialog_holo_light_frame"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvNum18"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18"
                        android:textColor="#333333"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvTxt18"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thứ 5"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDate19"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:drawable/dialog_holo_light_frame"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvNum19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19"
                        android:textColor="#333333"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvTxt19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thứ 6"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDate20"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:drawable/dialog_holo_light_frame"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvNum20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20"
                        android:textColor="#333333"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvTxt20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thứ 7"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDate21"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:layout_marginEnd="8dp"
                    android:background="@android:drawable/dialog_holo_light_frame"
                    android:backgroundTint="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvNum21"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21"
                        android:textColor="#333333"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvTxt21"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chủ nhật"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="12dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnBrandAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:id="@+id/imgAll"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="★"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#E91E63"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tất cả"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnBrandCGV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:id="@+id/imgCGV"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="CGV"
                        android:textColor="#E51937"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CGV"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnBrandBeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:id="@+id/imgBeta"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="Beta"
                        android:textColor="#00BCD4"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        android:backgroundTint="#FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beta Cine..."
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/layoutCinemaList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/itemBranch1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:backgroundTint="#FFFFFF"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvBranchName1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beta Giải Phóng"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/tvBranchAddress1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tầng 3, tòa IP2, Chung cư Imperial, số 360 Giải Phóng, Hà Nội"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>

                <LinearLayout
                    android:id="@+id/layoutShowtimes1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="10dp">

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2D Phụ đề" android:textStyle="bold" android:textColor="#111111" android:layout_marginBottom="8dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19:00 ~ 20:42" android:background="@android:drawable/dialog_holo_light_frame" android:backgroundTint="#EBF5FF" android:textColor="#007AFF" android:textStyle="bold" android:paddingHorizontal="12dp" android:paddingVertical="6dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemBranch2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:backgroundTint="#FFFFFF"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvBranchName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CGV Aeon Mall Hà Đông"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/tvBranchAddress2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tầng 3, TTTM Aeon Mall Hà Đông, Hà Nội"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>

                <LinearLayout
                    android:id="@+id/layoutShowtimes2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginTop="10dp">

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2D Lồng tiếng" android:textStyle="bold" android:textColor="#111111" android:layout_marginBottom="8dp"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20:00 ~ 21:42" android:background="@android:drawable/dialog_holo_light_frame" android:backgroundTint="#EBF5FF" android:textColor="#007AFF" android:textStyle="bold" android:paddingHorizontal="12dp" android:paddingVertical="6dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>



    </LinearLayout>
</ScrollView>